{
  "version": 3,
  "configurePresets": [
    {
      "name": "x86-release",
      "displayName": "Win XP ~ 11 (x86 32-bit Release)",
      "generator": "Ninja",
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-release",
      "displayName": "Win 7 ~ 11 (x64 64-bit Release)",
      "generator": "Ninja",
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-x86",
      "displayName": "Build Win XP ~ 11 (x86)",
      "configurePreset": "x86-release"
    },
    {
      "name": "build-x64",
      "displayName": "Build Win 7 ~ 11 (x64)",
      "configurePreset": "x64-release"
    }
  ]
}
